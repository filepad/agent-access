{
  "name": "@filepad/agent-access-public-repo",
  "private": true,
  "version": "0.1.0",
  "description": "Public Agent Access SDK and remote MCP pairing packages for Filepad.",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:filepad-sdk": "pnpm -C packages/sdk typecheck",
    "typecheck:agent-sdk": "pnpm -C packages/agent-access-sdk typecheck",
    "typecheck:agent-connect": "pnpm -C packages/agent-connect typecheck",
    "typecheck:claude-code-hooks": "pnpm -C packages/claude-code-hooks typecheck",
    "typecheck:guardian": "pnpm -C packages/guardian typecheck",
    "typecheck:runtime-adapter-claude-code": "pnpm -C packages/runtime-adapter-claude-code typecheck",
    "test:filepad-sdk": "pnpm -C packages/sdk test",
    "test:sdk": "pnpm -C packages/agent-access-sdk test",
    "test:agent-connect": "pnpm -C packages/agent-connect test",
    "test:claude-code-hooks": "pnpm -C packages/claude-code-hooks test",
    "test:guardian": "pnpm -C packages/guardian test",
    "test:runtime-adapter-claude-code": "pnpm -C packages/runtime-adapter-claude-code test",
    "check:agent-public-boundary": "node scripts/ci/check-agent-public-boundary.mjs",
    "pack:check:filepad-sdk": "pnpm -C packages/sdk pack:check",
    "pack:check:sdk": "pnpm -C packages/agent-access-sdk pack:check",
    "pack:check:agent-connect": "pnpm -C packages/agent-connect pack:check",
    "pack:check:claude-code-hooks": "pnpm -C packages/claude-code-hooks pack:check",
    "pack:check:guardian": "pnpm -C packages/guardian pack:check",
    "pack:check:runtime-adapter-claude-code": "pnpm -C packages/runtime-adapter-claude-code pack:check",
    "pack:check": "pnpm -C packages/sdk build && pnpm pack:check:filepad-sdk",
    "proof:clean-install": "node scripts/agent-access/clean-install-proof.mjs",
    "validate:sdk": "pnpm typecheck:filepad-sdk && pnpm test:filepad-sdk && pnpm pack:check:filepad-sdk",
    "validate:agent-access": "pnpm check:agent-public-boundary && pnpm typecheck:agent-sdk && pnpm test:sdk && pnpm typecheck:claude-code-hooks && pnpm test:claude-code-hooks && pnpm typecheck:agent-connect && pnpm test:agent-connect && pnpm typecheck:guardian && pnpm test:guardian && pnpm typecheck:runtime-adapter-claude-code && pnpm test:runtime-adapter-claude-code",
    "validate:all": "pnpm validate:sdk && pnpm validate:agent-access"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.2"
  }
}
